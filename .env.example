# Copia este archivo como ".env" (que NO se sube a git) y completa los valores.
# docker compose lo lee solo. Sin .env, todo funciona con H2 en memoria (perfil h2).

# h2 = base en memoria para desarrollo · oracle = Oracle Autonomous Database (OCI)
PERFIL=oracle

# Secreto para firmar y verificar los tokens JWT: el MISMO para los cuatro servicios.
# Al menos 32 caracteres aleatorios. Generar uno con, por ejemplo:   openssl rand -base64 48
JWT_SECRET=

# true solo si el sitio se publica con HTTPS.
JWT_COOKIE_SEGURA=false

# ---------- Conexión a Oracle ----------
# El wallet descomprimido va en la carpeta wallet/ (ver wallet/LEEME.md).
# ORACLE_SERVICIO es uno de los nombres que trae wallet/tnsnames.ora: <nombre de la base>_tp
# es el indicado para una base "Transaction Processing" (por ejemplo vetsm_tp).
ORACLE_SERVICIO=vetsm_tp

# ---------- Un usuario (esquema) por microservicio ----------
# Cada servicio entra con su propio usuario: ninguno ve las tablas de otro.
# Los crea el administrador de la base con el script de wallet/LEEME.md.
USUARIOS_DB_USER=VETSM_USUARIOS
USUARIOS_DB_PASSWORD=

CATALOGO_DB_USER=VETSM_CATALOGO
CATALOGO_DB_PASSWORD=

VENTAS_DB_USER=VETSM_VENTAS
VENTAS_DB_PASSWORD=

AGENDA_DB_USER=VETSM_AGENDA
AGENDA_DB_PASSWORD=

# ---------- Cuentas iniciales del personal ----------
# ms-usuarios crea admin@sanmarcos.cl y recepcion@sanmarcos.cl con estas contraseñas la primera vez
# que arranca con la base vacía. Si se dejan en blanco, esas cuentas no se crean.
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_PASSWORD=
