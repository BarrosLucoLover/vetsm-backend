# Copia este archivo como ".env" (que NO se sube a git) y completa los valores.
# Sirve de referencia de las variables de entorno que necesita el perfil "oracle".

SPRING_PROFILES_ACTIVE=oracle

# Conexión a Oracle Autonomous Database (OCI). TNS_ADMIN apunta a la carpeta del wallet descomprimido.
DB_URL=jdbc:oracle:thin:@NOMBRE_DEL_SERVICIO_high?TNS_ADMIN=C:/ruta/a/la/carpeta/del/wallet
DB_USER=
DB_PASSWORD=

# Contraseñas con las que se crean las cuentas iniciales del personal (solo la primera vez).
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_PASSWORD=
